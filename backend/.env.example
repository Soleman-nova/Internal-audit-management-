# EEU Internal Audit Management System — backend configuration
#
# Copy to `.env` alongside manage.py and edit. Every value below is read through
# python-decouple's `config()` in core/settings.py.
#
# Most have a working default, so a missing .env still boots in development.
# SECRET_KEY is the exception: it keeps an insecure default only while DEBUG is
# True, and is *required* when DEBUG=False — a deployment that skips this file
# fails to start rather than silently running with a published key.
#
# After editing, `python manage.py check --deploy` is the acceptance test: with
# DEBUG=False it must report no issues.

# ── Core ────────────────────────────────────────────────────────────────
# Generate a fresh one per environment:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
SECRET_KEY=change-me-generate-a-fresh-50-character-key
DEBUG=True
# Comma-separated, no spaces. Must include the deployment hostname when DEBUG=False.
ALLOWED_HOSTS=localhost,127.0.0.1

# ── Database ────────────────────────────────────────────────────────────
# True keeps everything in backend/db.sqlite3 — the default, and what the seed
# commands and test suite are exercised against. Set False to use the
# PostgreSQL block below; the DB_* values are ignored while this is True.
USE_SQLITE=True
DB_NAME=eeu_audit_db
DB_USER=postgres
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# ── JWT ─────────────────────────────────────────────────────────────────
# Refresh tokens rotate and the old one is blacklisted (ROTATE_REFRESH_TOKENS +
# BLACKLIST_AFTER_ROTATION in settings.py), so shortening the access lifetime
# costs the user nothing — the frontend's 401 interceptor refreshes silently.
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=60
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# ── Rate limiting ───────────────────────────────────────────────────────
# DRF throttle rates, in the "<number>/<period>" form DRF parses (second, minute,
# hour, day). THROTTLE_LOGIN is the one that matters: LoginView is AllowAny and
# usernames are the guessable EEU-##### pattern, so this is what stands between
# the login endpoint and unlimited credential stuffing. Raise it and you are
# choosing how fast an attacker may guess.
THROTTLE_ANON=60/min
THROTTLE_USER=1000/hour
THROTTLE_LOGIN=30/min

# ── CORS ────────────────────────────────────────────────────────────────
# The browser-side origins allowed to call this API — comma-separated, scheme
# included, no trailing slash. This must list wherever the built frontend is
# served from; the deployed origin is not localhost, and a missing entry shows
# up as every request failing in the browser while curl works fine.
#
# When DEBUG=False these are also used as CSRF_TRUSTED_ORIGINS.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://localhost:8000,http://localhost:5174

# ── Security (DEBUG=False only) ─────────────────────────────────────────
# The whole SECURE_* block in settings.py is gated on `not DEBUG`, so these are
# ignored in development and the dev server keeps working over plain HTTP.
#
# SECURE_SSL_REDIRECT sends every plain-HTTP request to HTTPS. Leave it True
# unless something in front of Django already terminates TLS and redirects —
# note settings.py also sets SECURE_PROXY_SSL_HEADER, without which a reverse
# proxy would turn this into an infinite redirect loop.
SECURE_SSL_REDIRECT=True
# HSTS max-age in seconds; 31536000 is one year. Browsers remember this per
# host, so start small (e.g. 3600) while confirming certificates work — a long
# max-age set by mistake locks clients out of the host over HTTP until it
# expires, and it cannot be recalled.
SECURE_HSTS_SECONDS=31536000

# ── Logto SSO ───────────────────────────────────────────────────────────
# Single sign-on via the self-hosted Logto instance. Additive: the employee-ID and
# password flow keeps working, and Django remains the authority on roles — Logto
# only establishes *who* the user is.
#
# Leaving these empty is a supported state. It disables POST /api/auth/logto/exchange/,
# which answers 503 rather than 401 so "this deployment has no Logto" stays
# distinguishable from "your token is bad".
#
# LOGTO_ENDPOINT is Logto core's base URL, without a trailing slash and without the
# /oidc suffix — the issuer and JWKS URL are derived from it in settings.py. Note
# this is the same host that serves the Console at <endpoint>/console.
LOGTO_ENDPOINT=http://172.16.7.25:3000
# App ID of the *Single Page Application* in Logto Console. It is the expected `aud`
# of the ID token, so a mismatch here rejects every sign-in even when everything
# else is correct. It is a public identifier, not a secret — it ships in the
# frontend bundle as VITE_LOGTO_APP_ID.
LOGTO_APP_ID=8cpjsf9wqi8j2rplic7ju
# Which ID-token claim carries the EEU employee ID. Leave empty to try the known
# candidates in order, which works with an unmodified Logto directory:
#
#   1. custom_data.EEUID   — the field this system provisions new accounts from
#   2. username            — finds an account an administrator already created
#   3. email               — last resort, same purpose
#
# Only custom_data.EEUID can create an account. The other two exist to *find* one,
# because keying a new account off a mutable profile field would let a rename or a
# recycled address claim an identity. Set this to pin one claim and fail loudly
# instead of falling back.
LOGTO_IDENTITY_CLAIM=

# Role given to an account auto-created on first Logto sign-in. Needs no setting:
# it is hardcoded to the lowest-privilege role ('auditee', which holds no
# capabilities at all) in apps/accounts/logto.py. Promotion to a real role is a
# deliberate, audited, Django-side action by an administrator.

# ── Logging ─────────────────────────────────────────────────────────────
# Root log level: DEBUG, INFO, WARNING, ERROR, or CRITICAL. Handlers write to the
# console and to a rotating backend/logs/audit_system.log (5 MB × 5). Unhandled
# view exceptions arrive on django.request, which is pinned at ERROR regardless
# of this value, so raising it to WARNING still keeps 500 tracebacks.
LOG_LEVEL=INFO

# ── Email ───────────────────────────────────────────────────────────────
# The console backend prints notification mail to the runserver log, which is
# what development wants. Swap to the SMTP backend and fill in the host
# credentials to actually deliver follow-up and overdue-CAPA reminders.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=EEU Audit System <noreply@eeu.com>

# ── Frontend ────────────────────────────────────────────────────────────
# Used for the links embedded in notification emails. Which origins the browser
# may call the API from is CORS_ALLOWED_ORIGINS above, not this value.
FRONTEND_URL=http://localhost:5173
