# EEU Internal Audit Management System — frontend configuration
#
# Copy to `.env` (or `.env.local`) in this directory. Vite only exposes
# variables prefixed with VITE_ to client code, and it inlines them at BUILD
# time — changing this file requires restarting `npm run dev` or rebuilding.

# Base URL of the Django API, including the /api prefix.
#
# Resolution order in src/api/apiClient.js is: the value saved in the in-app
# Settings modal (localStorage), then this variable, then the localhost default.
# Without it a production build is pinned to localhost:8000 and every request
# from a deployed frontend fails.
VITE_API_BASE_URL=http://localhost:8000/api

# ── Logto SSO ───────────────────────────────────────────────────────────
# Base URL of the self-hosted Logto instance: no trailing slash, and no /oidc
# suffix (the SDK appends what it needs).
#
# Both values are PUBLIC. A Logto Single Page Application is a public OAuth client
# using Authorization Code + PKCE, so there is no client secret anywhere — and
# Vite inlines these into the bundle regardless. Keep the *backend's*
# LOGTO_ENDPOINT/LOGTO_APP_ID in sync with these; a mismatch in the App ID
# surfaces as every exchange failing its audience check.
#
# Leaving both empty is supported: src/auth/logtoConfig.js treats it as "Logto not
# configured", the provider is not mounted, and the sign-in button is not rendered.
# The app then behaves exactly as it did before SSO was added.
#
# IMPORTANT — the redirect URIs are derived from `window.location.origin` in code,
# not from here, and they must be registered in Logto Console → Applications with
# an exact match. For local development that is:
#
#   Redirect URI            http://localhost:5173/callback
#   Post sign-out URI       http://localhost:5173/login
#
# Open the app at http://localhost:5173, not at a LAN IP. A bare IP over plain HTTP
# is not a secure context, so the browser withholds crypto.subtle and Logto's PKCE
# and signature verification cannot run. Serving on the LAN needs TLS on both this
# app and Logto itself.
VITE_LOGTO_ENDPOINT=http://172.16.7.25:3000
VITE_LOGTO_APP_ID=8cpjsf9wqi8j2rplic7ju
